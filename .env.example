# SPECTRA-XDR Environment Configuration Example

# Application Core Settings
APP_NAME=SPECTRA-XDR
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Settings (Planned for future phases)
DATABASE_URL=postgresql://user:password@localhost:5432/spectra_xdr

# Wazuh Telemetry Integration (Phase 1)
WAZUH_API_URL=https://localhost:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=wazuh-password
WAZUH_VERIFY_SSL=true
WAZUH_TIMEOUT=10

# Ollama Local LLM Settings (Planned for future phases)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini API Key (Planned for future phases)
GEMINI_API_KEY=

# Redis Cache & Bus Settings (Planned for future phases)
REDIS_URL=redis://localhost:6379/0
